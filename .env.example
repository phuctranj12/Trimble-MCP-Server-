# Trimble Identity application (Trimble Developer Console)
TRIMBLE_CLIENT_ID=
# Leave empty for a public PKCE client; set only if the app was registered as confidential
TRIMBLE_CLIENT_SECRET=
# Space-delimited: "openid" plus the application name registered with Trimble
TRIMBLE_SCOPE=openid your-app-name
# Must exactly match a callback registered for the application
TRIMBLE_REDIRECT_URI=http://localhost:8000/auth/trimble/callback
# Production: https://id.trimble.com  |  Stage: https://stage.id.trimble.com
TRIMBLE_IDENTITY_BASE=https://id.trimble.com
# Global entry point used to discover regional Connect endpoints
TRIMBLE_CONNECT_REGIONS_URL=https://app.connect.trimble.com/tc/api/2.0/regions

# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

DATABASE_PATH=trimble_mcp.db
# Where the browser goes after login (React dev server)
FRONTEND_URL=http://localhost:5173
# Set true behind HTTPS
COOKIE_SECURE=false
# Public hostnames allowed to reach /mcp besides localhost (JSON list), e.g. ["mcp-dev.example.com"]
MCP_ALLOWED_HOSTS=[]
